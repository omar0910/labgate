APP_NAME=LabGate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=labgate
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Identidad de la instalación (config/marca.php) ---------------------------
# Nombre del sistema y de la institución que aparecen en encabezados, correos y PDF.
MARCA_SISTEMA=LabGate
MARCA_INSTITUCION="Instituto Tecnológico Demo"
MARCA_INSTITUCION_LINEA_1="Instituto Tecnológico"
MARCA_INSTITUCION_LINEA_2=Demo
MARCA_SIGLAS=ITD
MARCA_DOMINIO_CORREO=instituto-demo.test

# --- Modo demostración (config/demo.php) --------------------------------------
# true sólo en un sitio público de prueba con datos ficticios: muestra los accesos
# con un clic, bloquea las acciones delicadas y reinicia los datos cada noche.
DEMO=false

# --- Respaldos de la base (pantalla Mantenimiento > Respaldos) -----------------
# Rutas de mysqldump y mysql si no están en el PATH del servidor.
# DB_DUMP_PATH=/usr/bin/mysqldump
# DB_MYSQL_PATH=/usr/bin/mysql
